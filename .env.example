# LLM Provider: 'gemini', 'ollama', or 'auto' (default: auto)
LLM_PROVIDER=gemini

# Google Gemini API Key
# Get one at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Optional model override (default: gemini-3.5-flash or gemini-3.5-flash-lite)
GEMINI_MODEL=gemini-3.5-flash

# Ollama Configuration (Local / Self-Hosted Open Models)
# Run local models with zero API keys (e.g. ollama run llama3.2)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2
